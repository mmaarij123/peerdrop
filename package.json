{
  "name": "peerdrop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:ui",
    "build:local-turn": "go -C deploy/local-turn build -o ../../build/peerdrop-turn.exe .",
    "check": "tsc --noEmit -p tsconfig.json && tsc -p frontend/tsconfig.json",
    "start": "node --env-file-if-exists=.env build/server.js",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "npm run build && node tests/browser.mjs",
    "build:ui": "tsx frontend/build.tsx && tailwindcss -i frontend/styles.css -o dist/styles.css --minify"
  },
  "dependencies": {
    "@fastify/static": "^10.1.11",
    "@fastify/websocket": "^11.3.7",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "redis": "^6.3.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "clsx": "^2.1.1",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
