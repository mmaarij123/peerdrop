# Local development. Copy to .env before overriding any defaults.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Leave blank for no PeerDrop file-size cap. Set a positive integer to impose a cap in MiB.
MAX_FILE_MIB=
INVITE_TTL_SECONDS=600
ACTIVE_TTL_SECONDS=7200
STUN_URLS=
TURN_URLS=
TURN_SHARED_SECRET=
TURN_SHARED_SECRET_FILE=
FORCE_RELAY=false
# Optional same-computer relay. Build it with npm run build:local-turn first.
LOCAL_TURN=false
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CREATE=20
RATE_LIMIT_JOIN=60
RATE_LIMIT_SIGNAL_BURST=100
RATE_LIMIT_SIGNAL_PER_SECOND=25
# Optional when running Node directly. Compose sets its internal Redis URL.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_URL_FILE=

# VPS Compose example. Set PUBLIC_ORIGIN=https://drop.example.com.
APP_DOMAIN=drop.example.com
TURN_DOMAIN=turn.example.com
TURN_PRIVATE_IP=192.0.2.10
TURN_PUBLIC_IP=192.0.2.10
TURN_SECRET_SOURCE_FILE=./.secrets/turn_shared_secret
# For production, also set STUN_URLS=stun:turn.example.com:3478 and
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
