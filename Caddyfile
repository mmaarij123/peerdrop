{
	log default {
		format filter {
			request>uri query {
				delete token
			}
		}
	}
}

{$APP_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	@node1 path_regexp node1 ^(/ws/signaling/01[a-f0-9]{30}|/peerjs/01/filepizza/peerjs)$
	@node2 path_regexp node2 ^(/ws/signaling/02[a-f0-9]{30}|/peerjs/02/filepizza/peerjs)$
	@invalidSignaling path /ws/signaling /ws/signaling/* /peerjs /peerjs/*
	handle @node1 {
		reverse_proxy {$APP_1_UPSTREAM:app:3000} {
			transport http {
				dial_timeout 2s
			}
		}
	}
	handle @node2 {
		reverse_proxy {$APP_2_UPSTREAM:app2:3000} {
			transport http {
				dial_timeout 2s
			}
		}
	}
	handle @invalidSignaling {
		header Content-Type application/json
		respond `{"error":"invalid_invite"}` 400
	}
	handle {
		reverse_proxy {$APP_1_UPSTREAM:app:3000} {$APP_2_UPSTREAM:app2:3000} {
			lb_policy round_robin
			health_uri /healthz
			health_interval 5s
			health_timeout 2s
			fail_duration 10s
			lb_try_duration 2s
			lb_retry_match method GET HEAD
			transport http {
				dial_timeout 2s
			}
		}
	}
	handle_errors 502 503 504 {
		header Content-Type application/json
		header Cache-Control no-store
		header Retry-After 5
		respond `{"error":"upstream_unavailable"}` 503
	}
}
